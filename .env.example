# OAuth Social Login (Google)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/social/callback

# OAuth Social Login (Kakao)
OAUTH_KAKAO_CLIENT_ID=
OAUTH_KAKAO_CLIENT_SECRET=
OAUTH_KAKAO_REDIRECT_URI=http://localhost:5173/auth/social/callback

# Optional
OAUTH_STATE_EXPIRATION_SECONDS=300

