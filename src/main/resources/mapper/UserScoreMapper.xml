<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.woorido.common.mapper.UserScoreMapper">

    <!-- 사용자 당도 점수 조회 -->
    <select id="findBrixByUserId" resultType="java.math.BigDecimal">
        SELECT total_score 
        FROM woorido.user_scores 
        WHERE user_id = #{userId}
    </select>

</mapper>
